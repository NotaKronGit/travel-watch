# Независимые от dev пароли; файл копируется в корень как .env.stage_local.
POSTGRES_PASSWORD=replace-stage-local-postgres-password
CABINET_DATABASE_OWNER_PASSWORD=replace-stage-local-owner-password
CABINET_DATABASE_APP_PASSWORD=replace-stage-local-app-password
STAGE_LOCAL_PORT=18080
IMAGE_TAG=local

# Отдельные роли Search.
SEARCH_DATABASE_OWNER_PASSWORD=replace-search-owner-password
SEARCH_DATABASE_APP_PASSWORD=replace-search-app-password

# Источники построения; реальные ключи хранить только в локальном env.
COLLECTOR_YANDEX_API_KEY=
SEARCH_GEMINI_API_KEY=
SEARCH_PROGRESS_SOURCES=graph,gemini
