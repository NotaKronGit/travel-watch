# Скопируйте в .env.dev и задайте отдельные пароли для этого стенда.
POSTGRES_PASSWORD=replace-dev-postgres-password
CABINET_DATABASE_OWNER_PASSWORD=replace-dev-owner-password
CABINET_DATABASE_APP_PASSWORD=replace-dev-app-password
DEV_PORT=18081
IMAGE_PREFIX=ghcr.io/notakrongit/travel-watch
IMAGE_TAG=dev-latest

# Отдельные роли Search.
SEARCH_DATABASE_OWNER_PASSWORD=replace-search-owner-password
SEARCH_DATABASE_APP_PASSWORD=replace-search-app-password
