# Только локальная разработка. Замените все значения своими паролями.
POSTGRES_PASSWORD=replace-local-postgres-password
CABINET_DATABASE_OWNER_PASSWORD=replace-local-owner-password
CABINET_DATABASE_APP_PASSWORD=replace-local-app-password
CABINET_DATABASE_PORT=55432
CABINET_SERVER_ADDRESS=127.0.0.1:8080
CABINET_SERVER_ORIGIN=http://localhost:5173
# false допустимо только для локального HTTP; для HTTPS оставьте true.
CABINET_AUTH_COOKIE_SECURE=false

# Отдельные роли Search.
SEARCH_DATABASE_OWNER_PASSWORD=replace-search-owner-password
SEARCH_DATABASE_APP_PASSWORD=replace-search-app-password
