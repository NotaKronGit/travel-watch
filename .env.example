# Только локальная разработка. Замените все три значения своими паролями.
POSTGRES_PASSWORD=replace-local-postgres-password
CABINET_OWNER_PASSWORD=replace-local-owner-password
CABINET_APP_PASSWORD=replace-local-app-password
POSTGRES_PORT=55432
CABINET_ADDR=127.0.0.1:8080
CABINET_ORIGIN=http://localhost:5173
# false допустимо только для локального HTTP; для HTTPS оставьте true.
CABINET_COOKIE_SECURE=false
